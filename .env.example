# Configuração local do Pulso 192.
# Aqui deve ser configurado as credenciais personalizadas;
# SE NÃO, serão usadas as credenciais padrão setadas em docker-compose.yml
POSTGRES_DB=pulso192_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ORACLE_PASSWORD=oracle
POSTGRES_HOST_PORT=5432
ORACLE_HOST_PORT=1521
API_HOST_PORT=8080
API_KEY=local-only-development-key

# Opcional: conexão com um Oracle externo, por exemplo o do cliente.
# Se omitida, a API usa o Oracle local do Docker e ORACLE_PASSWORD acima.
# ORACLE_CONNECTION_STRING=Data Source=//host:1521/service_name;User Id=usuario;Password=senha;